model User {
  id         Int     @id @default(autoincrement())
  name       String
  email      String  @unique
  resetToken String?
  articles   Article[]
}

model Article {
  id       Int    @id @default(autoincrement())
  title    String
  status   String
  author   User   @relation(fields: [authorId], references: [id])
  authorId Int
}
